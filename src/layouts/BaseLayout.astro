---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const { title = "FlashLearn", description } = Astro.props;

// TODO: Replace with actual Supabase session check
// This will be implemented when backend integration is ready
const user = null; // await getUserFromSession(Astro.cookies);
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="generator" content={Astro.generator} />
    {description && <meta name="description" content={description} />}
    <title>{title}</title>
  </head>
  <body>
    <nav class="bg-white border-b shadow-sm">
      <div class="container mx-auto px-4 py-3">
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-6">
            <a href="/" class="text-2xl font-bold text-primary hover:text-primary/80 transition-colors">
              FlashLearn
            </a>
            
            {user && (
              <div class="hidden md:flex items-center gap-4">
                <a 
                  href="/dashboard" 
                  class="text-sm text-gray-600 hover:text-gray-800 transition-colors"
                >
                  Dashboard
                </a>
                <a 
                  href="/generate" 
                  class="text-sm text-gray-600 hover:text-gray-800 transition-colors"
                >
                  Generuj fiszki
                </a>
              </div>
            )}
          </div>

          <div class="flex items-center gap-3">
            {!user ? (
              <>
                <a 
                  href="/login" 
                  class="px-4 py-2 text-sm text-gray-600 hover:text-gray-800 transition-colors"
                >
                  Zaloguj się
                </a>
                <a 
                  href="/register" 
                  class="px-4 py-2 text-sm bg-primary text-white rounded-md hover:bg-primary/90 transition-colors"
                >
                  Zarejestruj się
                </a>
              </>
            ) : (
              <div class="relative">
                <!-- User avatar and dropdown will be implemented here -->
                <div class="flex items-center gap-3">
                  <div class="w-8 h-8 bg-primary rounded-full flex items-center justify-center text-white text-sm font-medium">
                    {user.email?.[0]?.toUpperCase() || 'U'}
                  </div>
                  <span class="text-sm text-gray-700 hidden sm:block">{user.email}</span>
                  <!-- Logout button placeholder -->
                  <button 
                    type="button"
                    class="text-sm text-gray-600 hover:text-gray-800 transition-colors"
                    onclick="/* TODO: Implement logout */"
                  >
                    Wyloguj
                  </button>
                </div>
              </div>
            )}
          </div>
        </div>
      </div>
    </nav>

    <main>
      <slot />
    </main>

    <footer class="bg-gray-50 border-t py-8 mt-16">
      <div class="container mx-auto px-4 text-center">
        <p class="text-sm text-gray-600">
          © 2024 FlashLearn. Wszystkie prawa zastrzeżone.
        </p>
      </div>
    </footer>
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>